# If you want Electrum to appear in a Linux app launcher ("start menu"), install this by doing:
# sudo desktop-file-install electrum.desktop
# Note: This assumes $HOME/.local/bin is in your $PATH

[Desktop Entry]
Comment=Lightweight WojakCoin Client
Exec=electrum %u
GenericName[en_US]=WojakCoin Wallet
GenericName=WojakCoin Wallet
Icon=electrum
Name[en_US]=Electrum WojakCoin Wallet
Name=Electrum WojakCoin Wallet
Categories=Finance;Network;
StartupNotify=true
StartupWMClass=electrum
Terminal=false
Type=Application
MimeType=x-scheme-handler/wojakcoin;x-scheme-handler/bitcoin;x-scheme-handler/lightning;
Actions=Testnet;
Keywords=crypto;currency;WJK;WojakCoin

[Desktop Action Testnet]
Exec=electrum --testnet %u
Name=Testnet mode
